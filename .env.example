# ─── PROVEEDOR LLM ────────────────────────────────────────────────────────────
# Opciones: gemini | ollama
# - gemini: usar durante desarrollo (gratis, rápido)
# - ollama: usar en producción (privacidad, sin costo, offline)
LLM_PROVIDER=gemini

# ─── GEMINI (desarrollo) ───────────────────────────────────────────────────────
# Obtener API key gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# ─── OLLAMA (producción) ───────────────────────────────────────────────────────
# URL del servidor Ollama (el servicio en docker-compose se llama "ollama")
OLLAMA_BASE_URL=http://ollama:11434
# Modelo a usar — requiere mínimo 8 GB RAM
OLLAMA_MODEL=llama3.1:8b

# ─── CHROMADB ─────────────────────────────────────────────────────────────────
# Estos valores los sobreescribe docker-compose.yml automáticamente
# Solo cambiar si se ejecuta el backend fuera de Docker
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── EMBEDDINGS ───────────────────────────────────────────────────────────────
# Modelo multilingüe para español — no cambiar salvo pruebas
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# ─── RAG ──────────────────────────────────────────────────────────────────────
# Tamaño de cada fragmento de texto en tokens
CHUNK_SIZE=500
# Tokens de solapamiento entre fragmentos consecutivos
CHUNK_OVERLAP=50
# Cantidad de fragmentos recuperados de ChromaDB por consulta
TOP_K_RESULTS=5

# ─── RERANKING (Mejora 2) ─────────────────────────────────────────────────────
# Cross-Encoder que reordena los candidatos recuperados por ChromaDB.
# Mejora la precisión del retrieval ~26%. Añade ~100-200ms por consulta en CPU.
# Cambiar a false si el servidor es muy lento o para medir impacto en la tesis.
RERANKER_ENABLED=true
# Modelo multilingüe con soporte para español (280 MB).
# Se descarga automáticamente en el volumen hf_cache de Docker.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Cuántos candidatos pide a ChromaDB antes de rerankear.
# El reranker los reduce a TOP_K_RESULTS. Más candidatos = más preciso pero más lento.
RERANKER_CANDIDATES=20

# ─── CHUNKING PARENT-CHILD (Mejora 3) ────────────────────────────────────────
# Tamaños en CARACTERES (no tokens). Regla empírica: 1 token ≈ 4 caracteres en español.
#
# HIJO — fragmento pequeño que se indexa en ChromaDB como embedding.
#   Vector enfocado en un solo tema → retrieval más preciso.
#   400 chars ≈ 100 tokens
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=80
#
# PADRE — fragmento mayor que se pasa al LLM como contexto.
#   Contiene al hijo más su contexto circundante → el LLM puede responder mejor.
#   1600 chars ≈ 400 tokens
PARENT_CHUNK_SIZE=1600
PARENT_CHUNK_OVERLAP=100
#
# IMPORTANTE: después de cambiar estos valores hay que re-ingestar todos los documentos:
#   docker compose exec backend python ingest.py

# ─── HISTORIAL DE CONVERSACIÓN (Mejora 1) ────────────────────────────────────
# Cuántos mensajes anteriores se pasan al LLM para mantener el hilo de la conversación.
# 6 = últimos 3 intercambios (1 user + 1 assistant = 1 intercambio).
# Aumentar si los estudiantes hacen conversaciones largas; bajar si hay problemas de latencia.
HISTORY_WINDOW=6
# Ruta del archivo SQLite donde se guarda el historial de conversaciones.
# En Docker queda físicamente en ./backend/chatbot.db en el host (volumen montado).
# No cambiar salvo que muevas el proyecto fuera de Docker.
DB_PATH=/app/chatbot.db
